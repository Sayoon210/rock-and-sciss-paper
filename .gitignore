# Godot 4+ specific ignores
.godot/
/android/

# .NET
bin/
obj/
*.user

# Art sources. Only the exported .glb belongs in the repo — these are the
# files it was made from, and they live in Assets/_Source/, which carries a
# .gdignore so Godot does not import them either.
# .blend1/.blend2 are Blender's own save-time backups.
*.blend
*.blend[0-9]
*.fbx

# The rest of Assets/_Source/ is the same kind of thing, just not by extension —
# the retired CardSprite.png atlas sheet, card art as it was before being
# normalised to one size. Kept on disk, out of the repo. .gdignore is the one
# file that has to stay, since it is what makes Godot skip the folder.
Assets/_Source/*
!Assets/_Source/.gdignore
