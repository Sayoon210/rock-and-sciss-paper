; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="RockAndScissPaper"
run/main_scene="res://Scenes/Screens/TitleScreen.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

CardDatabase="*res://Scripts/Autoload/CardDatabase.cs"
EventBus="*res://Scripts/Autoload/EventBus.cs"
NetworkManager="*res://Scripts/Autoload/NetworkManager.cs"
GameState="*res://Scripts/Autoload/GameState.cs"

[display]

window/size/viewport_width=1600
window/size/viewport_height=1000
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="RockAndScissPaper"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
