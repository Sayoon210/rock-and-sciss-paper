; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="RockAndScissPaper 3D"
run/main_scene="res://Scenes/Screens/TitleScreen.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="res://Assets/Audio/DefaultBusLayout.tres"

[autoload]

AudioManager="*res://Scripts/Autoload/AudioManager.cs"
CardDatabase="*res://Scripts/Autoload/CardDatabase.cs"
EventBus="*res://Scripts/Autoload/EventBus.cs"
NetworkManager="*res://Scripts/Autoload/NetworkManager.cs"
GameState="*res://Scripts/Autoload/GameState.cs"

[display]

window/size/viewport_width=1600
window/size/viewport_height=1000
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="RockAndScissPaper"

[editor]

run/main_run_args="--resolution 960x600"

[filesystem]

import/blender/enabled=false

[gui]

theme/custom="res://Assets/Fonts/DefaultTheme.tres"

[internationalization]

locale/translations=PackedStringArray("res://Data/Translations/strings.en.translation", "res://Data/Translations/strings.ko.translation")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
